# Nod workspace for Railway: upstream Dockerfile.workspace plus the relay
# agent. A Railway service gets one volume, mounted at /workspace; upstream
# expects two (/workspace and /home/node for installed tools). The image
# moves the stock /home/node aside as a skeleton and symlinks /home/node
# into the volume at /workspace/.nod-home, so both persist.
ARG BASE=nod-base-workspace
FROM ${BASE}
USER root
RUN apt-get update && apt-get install -y --no-install-recommends util-linux && rm -rf /var/lib/apt/lists/*
RUN mv /home/node /opt/nod-home-skel && ln -s /workspace/.nod-home /home/node
COPY --chmod=444 relay/nod-relay-agent.mjs /opt/nod-relay/nod-relay-agent.mjs
COPY --chmod=555 images/workspace-entry.sh /usr/local/bin/nod-railway-workspace
ENV NOD_RELAY_MODE=workspace
CMD ["/usr/local/bin/nod-railway-workspace"]
