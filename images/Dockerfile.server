# Nod server for Railway: upstream deployment/self-host/Dockerfile plus the
# docker shim from relay/. The base image is built from the pinned upstream
# tag (see .github/workflows/images.yml); upstream publishes no images.
ARG BASE=nod-base-server
FROM ${BASE}
USER root
# util-linux provides setpriv, used by the entry script to drop to node.
RUN apt-get update && apt-get install -y --no-install-recommends util-linux && rm -rf /var/lib/apt/lists/*
COPY --chmod=555 relay/docker /usr/local/bin/docker
COPY --chmod=555 images/server-entry.sh /usr/local/bin/nod-railway-server
WORKDIR /app
CMD ["/usr/local/bin/nod-railway-server"]
